{
  "version": 2,
  "builds": [
    { "src": "api/index.js", "use": "@vercel/node" },
    { "src": "frontend/**/*", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/auth(?:/|$)(.*)", "dest": "/api/index.js" },
    { "src": "/api/transaksi(?:/|$)(.*)", "dest": "/api/index.js" },
    { "src": "/transaksi(?:/|$)(.*)", "dest": "/api/index.js" },
    { "src": "/dashboard.css", "dest": "/frontend/dashboard.css" },
    { "src": "/dashboard.js", "dest": "/frontend/dashboard.js" },
    { "src": "/login.css", "dest": "/frontend/login.css" },
    { "src": "/login.js", "dest": "/frontend/login.js" },
    { "src": "/dashboard.html", "dest": "/frontend/dashboard.html" },
    { "src": "/", "dest": "/frontend/index.html" }
  ]
}
